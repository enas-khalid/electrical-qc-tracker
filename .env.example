# Copy this file to .env and fill in your key to enable "Run AI Review".
# The server loads .env automatically on startup (Node's process.loadEnvFile()).
#
# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the model used for AI review (defaults to gemini-3.1-pro-preview).
# Note: some API keys' free tier has zero quota for Pro-tier models — if you hit a
# 429 RESOURCE_EXHAUSTED error, either enable billing on the Google AI Studio project
# or switch this to a Flash-tier model (e.g. gemini-2.5-flash).
# GEMINI_MODEL=gemini-3.1-pro-preview

# Optional: max size in MB for a single PDF (uploaded or from the local KSRT
# folder) that AI review will read. Defaults to 50. Parsing briefly uses much
# more RAM than the file's own size, so only raise this if your host has RAM
# to spare — it can safely go much higher on your own machine (400+ MB) than
# on a small hosted plan.
# MAX_INGEST_MB=50

# Optional: where the SQLite database file lives. Defaults to ./data locally.
# On a deployed host, set this to a mounted persistent disk/volume path so the
# database survives restarts and redeploys — see README > Deploying.
# DATA_DIR=/var/data
